  miniStatDivider: {
    width: 1,
    height: 20,
    backgroundColor: colors.border,
  },
  sectionTitle: {
    ...typography.label,
    fontSize: 12,
    color: colors.textDim,
    letterSpacing: 1,
    marginBottom: spacing.xs,
  },
  plansHeader: {
    flexDirection: "row",
    justifyContent: "space-between",
    alignItems: "center",
    marginBottom: spacing.xs,
  },
  viewAllLink: {
    ...typography.caption,
    fontSize: 12,
    fontWeight: "600",
    color: colors.primary,
  },
  planCard: {
    marginBottom: spacing.sm,
    padding: spacing.md,
  },
  planTop: {
    flexDirection: "row",
    alignItems: "center",
    justifyContent: "space-between",
  },
  planIconBox: {
    width: 38,
    height: 38,
    borderRadius: radius.sm,
    backgroundColor: "rgba(124, 92, 255, 0.15)",
    alignItems: "center",
