    fontSize: 12,
    color: "rgba(255, 255, 255, 0.9)",
    marginTop: 2,
  },
  streakDaysBadge: {
    backgroundColor: "rgba(0,0,0,0.25)",
    paddingHorizontal: 10,
    paddingVertical: 4,
    borderRadius: radius.pill,
  },
  streakDaysText: {
    color: "#FFFFFF",
    fontWeight: "800",
    fontSize: 11,
    letterSpacing: 0.5,
  },
  goalCard: {
    marginBottom: spacing.lg,
    padding: spacing.md,
  },
  goalRow: {
    flexDirection: "row",
    alignItems: "center",
    gap: 16,
  },
